# Optional. Grok sign-in uses pi's built-in SuperGrok / X Premium login.
# Set this only to use your own xAI client registration (with these scopes).
XAI_OAUTH_CLIENT_ID=
XAI_OAUTH_SCOPES=openid profile email offline_access api:access
# Optional for a confidential client. Leave empty for a public client.
XAI_OAUTH_CLIENT_SECRET=
# Required in production. Generate with: openssl rand -base64 32
NEUROPLAST_CREDENTIAL_KEY=
# Persistent writable directory; defaults to .neuroplast in development.
NEUROPLAST_DATA_DIR=
# Canonical HTTPS origin behind a reverse proxy, e.g. https://neuroplast.example
NEUROPLAST_ORIGIN=
# Required in production: the password that gates the private workspace.
NEUROPLAST_WORKSPACE_PASSWORD=
# Read-only study materials for file tools. Never point this at server secrets.
NEUROPLAST_MATERIALS_DIR=
# Where the sidebar's "Source code" link points (AGPL section 13). Set it to
# your own repository when you deploy a modified version.
NEXT_PUBLIC_NEUROPLAST_SOURCE_URL=
